{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 10000,
      "catalog": 5000,
      "execution": 60000
    },
    "servers": {
      "filesystem": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
        "disabled": true
      },
      "remote-oauth-example": {
        "type": "remote",
        "url": "https://example.com/mcp",
        "oauth": {},
        "disabled": true
      },
      "remote-example": {
        "type": "remote",
        "url": "https://example.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:MCP_TOKEN}"
        },
        "oauth": false,
        "disabled": true
      }
    }
  }
}
